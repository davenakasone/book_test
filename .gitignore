# Quarto render output + caches
book/_book/
book/.quarto/
book/index_files/
book/site_libs/
/.quarto/

# LaTeX intermediates. keep-tex still generates book/*.tex locally (handy for
# debugging glyph/layout issues) but we no longer COMMIT it — it drifts from
# source on every render and bloats diffs. The PDF is the deliverable.
book/*.tex
*.aux
*.log
*.toc
*.out
*.idx
*.ilg
*.ind
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
parked/latex-shootout/build/

# Author's raw source material (template mode — see START-HERE.md); their
# originals shouldn't land in git. Extracted media does (it's a build input).
incoming/

# OS / editor
.DS_Store

# Built book — distributed via GitHub Releases, not committed. A stale
# convenience copy from older build.py versions may sit here; it stays untracked.
/The-Starlight-Engine.pdf

# Stray per-chapter renders (quarto single-file renders drop these next to sources)
book/chapters/*.html
book/chapters/*_files/

# Machine-owned review output — regenerable, never versioned
tool_output/

# Template render output + figures generated from data/*.csv (new.py and
# build.py regenerate them; the hand-drawn typical-application.svg is tracked)
templates/*/_output/
templates/*/_book/
templates/*/.quarto/
templates/article/figures/results.svg
templates/datasheet/figures/efficiency.svg
templates/datasheet/figures/line-regulation.svg
